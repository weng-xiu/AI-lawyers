<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiCallerProfileMapper">

    <resultMap type="AiCallerProfile" id="AiCallerProfileResult">
        <result property="profileId"          column="profile_id"          />
        <result property="callerNumber"       column="caller_number"       />
        <result property="callerNumberIndex"  column="caller_number_index" />
        <result property="callerName"         column="caller_name"         />
        <result property="callerGender"       column="caller_gender"       />
        <result property="callerAge"          column="caller_age"          />
        <result property="callerIdCard"       column="caller_id_card"      />
        <result property="callerIdCardIndex"  column="caller_id_card_index" />
        <result property="callerAddress"      column="caller_address"      />
        <result property="customerLevel"      column="customer_level"      />
        <result property="tags"               column="tags"                />
        <result property="intentPrediction"   column="intent_prediction"   />
        <result property="intentConfidence"   column="intent_confidence"   />
        <result property="consultPreference"  column="consult_preference"  />
        <result property="highFreqProblem"    column="high_freq_problem"   />
        <result property="freqMentionCount"   column="freq_mention_count"  />
        <result property="riskLevel"          column="risk_level"          />
        <result property="emotionStatus"      column="emotion_status"      />
        <result property="emotionWarning"     column="emotion_warning"     />
        <result property="lastCallTime"       column="last_call_time"      />
        <result property="languagePreference" column="language_preference" />
        <result property="careMode"           column="care_mode"           />
        <result property="createBy"           column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"           column="update_by"           />
        <result property="updateTime"         column="update_time"         />
        <result property="remark"             column="remark"              />
    </resultMap>

    <sql id="selectAiCallerProfileVo">
        select profile_id, caller_number, caller_number_index, caller_name, caller_gender, caller_age, caller_id_card, caller_id_card_index, caller_address,
               customer_level, tags, intent_prediction, intent_confidence, consult_preference, high_freq_problem,
               freq_mention_count, risk_level, emotion_status, emotion_warning, last_call_time,
               language_preference, care_mode,
               create_by, create_time, update_by, update_time, remark
        from ai_caller_profile
    </sql>

    <select id="selectAiCallerProfileList" parameterType="AiCallerProfile" resultMap="AiCallerProfileResult">
        <include refid="selectAiCallerProfileVo"/>
        <where>
            <if test="callerNumber != null and callerNumber != ''">
                <!-- G1-b2：LIKE '%kw%' 改走 CALLER_PROFILE 位置分片盲 token（9.57.4 随本任务落地） -->
                <choose>
                    <when test="tokenGroups != null and tokenGroups.size() > 0">
                        and (
                        <foreach collection="tokenGroups" item="grp" separator=" or ">
                            profile_id in (
                                select owner_id from ai_pii_search_token
                                where owner_type = 'CALLER_PROFILE'
                                  and token_value in
                                <foreach collection="grp" item="tok" open="(" separator="," close=")">
                                    #{tok}
                                </foreach>
                                group by owner_id
                                having count(distinct token_value) = (
                                    select count(distinct sq.tok) from
                                    <foreach collection="grp" item="t" open="(select " separator=" union all select " close=") sq">
                                        #{t} as tok
                                    </foreach>
                                )
                            )
                        </foreach>
                        )
                    </when>
                    <otherwise>and 1 = 0</otherwise>
                </choose>
            </if>
            <if test="callerName != null and callerName != ''"> and caller_name like concat('%', #{callerName}, '%')</if>
            <if test="customerLevel != null and customerLevel != ''"> and customer_level = #{customerLevel}</if>
            <if test="riskLevel != null and riskLevel != ''"> and risk_level = #{riskLevel}</if>
        </where>
        order by last_call_time desc
    </select>

    <select id="selectAiCallerProfileByProfileId" parameterType="Long" resultMap="AiCallerProfileResult">
        <include refid="selectAiCallerProfileVo"/>
        where profile_id = #{profileId}
    </select>

    <!-- G1-b：caller_number 已存 SM4-GCM 密文，等值查询改走盲索引列 -->
    <select id="selectAiCallerProfileByCallerNumberIndex" parameterType="String" resultMap="AiCallerProfileResult">
        <include refid="selectAiCallerProfileVo"/>
        where caller_number_index = #{callerNumberIndex}
    </select>

    <!-- G1-b2 迁移专用：原始密文/盲索引（resultType=map 绕过解密拦截器，驼峰别名） -->
    <select id="selectRawForMigrate" resultType="map">
        select profile_id as profileId,
               caller_number as callerNumber,
               caller_number_index as callerNumberIndex,
               caller_id_card as callerIdCard,
               caller_id_card_index as callerIdCardIndex
        from ai_caller_profile
    </select>

    <insert id="insertAiCallerProfile" parameterType="AiCallerProfile" useGeneratedKeys="true" keyProperty="profileId">
        insert into ai_caller_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="callerNumber != null and callerNumber != ''">caller_number,</if>
            <if test="callerNumberIndex != null and callerNumberIndex != ''">caller_number_index,</if>
            <if test="callerName != null">caller_name,</if>
            <if test="callerGender != null">caller_gender,</if>
            <if test="callerAge != null">caller_age,</if>
            <if test="callerIdCard != null">caller_id_card,</if>
            <if test="callerIdCardIndex != null and callerIdCardIndex != ''">caller_id_card_index,</if>
            <if test="callerAddress != null">caller_address,</if>
            <if test="customerLevel != null">customer_level,</if>
            <if test="tags != null">tags,</if>
            <if test="intentPrediction != null">intent_prediction,</if>
            <if test="intentConfidence != null">intent_confidence,</if>
            <if test="consultPreference != null">consult_preference,</if>
            <if test="highFreqProblem != null">high_freq_problem,</if>
            <if test="freqMentionCount != null">freq_mention_count,</if>
            <if test="riskLevel != null">risk_level,</if>
            <if test="emotionStatus != null">emotion_status,</if>
            <if test="emotionWarning != null">emotion_warning,</if>
            <if test="lastCallTime != null">last_call_time,</if>
            <if test="languagePreference != null">language_preference,</if>
            <if test="careMode != null">care_mode,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="callerNumber != null and callerNumber != ''">#{callerNumber},</if>
            <if test="callerNumberIndex != null and callerNumberIndex != ''">#{callerNumberIndex},</if>
            <if test="callerName != null">#{callerName},</if>
            <if test="callerGender != null">#{callerGender},</if>
            <if test="callerAge != null">#{callerAge},</if>
            <if test="callerIdCard != null">#{callerIdCard},</if>
            <if test="callerIdCardIndex != null and callerIdCardIndex != ''">#{callerIdCardIndex},</if>
            <if test="callerAddress != null">#{callerAddress},</if>
            <if test="customerLevel != null">#{customerLevel},</if>
            <if test="tags != null">#{tags},</if>
            <if test="intentPrediction != null">#{intentPrediction},</if>
            <if test="intentConfidence != null">#{intentConfidence},</if>
            <if test="consultPreference != null">#{consultPreference},</if>
            <if test="highFreqProblem != null">#{highFreqProblem},</if>
            <if test="freqMentionCount != null">#{freqMentionCount},</if>
            <if test="riskLevel != null">#{riskLevel},</if>
            <if test="emotionStatus != null">#{emotionStatus},</if>
            <if test="emotionWarning != null">#{emotionWarning},</if>
            <if test="lastCallTime != null">#{lastCallTime},</if>
            <if test="languagePreference != null">#{languagePreference},</if>
            <if test="careMode != null">#{careMode},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiCallerProfile" parameterType="AiCallerProfile">
        update ai_caller_profile
        <trim prefix="SET" suffixOverrides=",">
            <if test="callerNumber != null and callerNumber != ''">caller_number = #{callerNumber},</if>
            <if test="callerNumberIndex != null and callerNumberIndex != ''">caller_number_index = #{callerNumberIndex},</if>
            <if test="callerName != null">caller_name = #{callerName},</if>
            <if test="callerGender != null">caller_gender = #{callerGender},</if>
            <if test="callerAge != null">caller_age = #{callerAge},</if>
            <if test="callerIdCard != null">caller_id_card = #{callerIdCard},</if>
            <if test="callerIdCardIndex != null and callerIdCardIndex != ''">caller_id_card_index = #{callerIdCardIndex},</if>
            <if test="callerAddress != null">caller_address = #{callerAddress},</if>
            <if test="customerLevel != null">customer_level = #{customerLevel},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="intentPrediction != null">intent_prediction = #{intentPrediction},</if>
            <if test="intentConfidence != null">intent_confidence = #{intentConfidence},</if>
            <if test="consultPreference != null">consult_preference = #{consultPreference},</if>
            <if test="highFreqProblem != null">high_freq_problem = #{highFreqProblem},</if>
            <if test="freqMentionCount != null">freq_mention_count = #{freqMentionCount},</if>
            <if test="riskLevel != null">risk_level = #{riskLevel},</if>
            <if test="emotionStatus != null">emotion_status = #{emotionStatus},</if>
            <if test="emotionWarning != null">emotion_warning = #{emotionWarning},</if>
            <if test="lastCallTime != null">last_call_time = #{lastCallTime},</if>
            <if test="languagePreference != null and languagePreference != ''">language_preference = #{languagePreference},</if>
            <if test="careMode != null">care_mode = #{careMode},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where profile_id = #{profileId}
    </update>

    <!-- F1/F2：更新语种偏好与适老关怀模式（弹屏手动切换） -->
    <update id="updatePreference">
        update ai_caller_profile
        set language_preference = #{languagePreference},
            care_mode = #{careMode},
            update_time = sysdate()
        where profile_id = #{profileId}
    </update>

    <delete id="deleteAiCallerProfileByProfileId" parameterType="Long">
        delete from ai_caller_profile where profile_id = #{profileId}
    </delete>

    <delete id="deleteAiCallerProfileByProfileIds" parameterType="String">
        delete from ai_caller_profile where profile_id in
        <foreach item="profileId" collection="array" open="(" separator="," close=")">
            #{profileId}
        </foreach>
    </delete>
</mapper>
