<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiLegalKnowledgeMapper">
    
    <resultMap type="AiLegalKnowledge" id="AiLegalKnowledgeResult">
        <result property="knowledgeId"      column="knowledge_id"      />
        <result property="title"           column="title"            />
        <result property="content"         column="content"          />
        <result property="categoryId"      column="category_id"      />
        <result property="lawArticle"      column="law_article"      />
        <result property="source"          column="source"           />
        <result property="keywords"        column="keywords"         />
        <result property="viewCount"       column="view_count"       />
        <result property="status"           column="status"           />
        <result property="auditStatus"      column="audit_status"      />
        <result property="auditBy"          column="audit_by"         />
        <result property="auditTime"        column="audit_time"       />
        <result property="auditRemark"      column="audit_remark"     />
        <result property="lawName"          column="law_name"         />
        <result property="articleNo"        column="article_no"       />
        <result property="issuingAuthority" column="issuing_authority"/>
        <result property="effectiveDate"    column="effective_date"   />
        <result property="validStatus"      column="valid_status"     />
        <result property="sourceUrl"        column="source_url"       />
        <result property="publishVersion"   column="publish_version"  />
        <result property="createBy"         column="create_by"        />
        <result property="createTime"       column="create_time"      />
        <result property="updateBy"         column="update_by"        />
        <result property="updateTime"       column="update_time"      />
        <result property="remark"           column="remark"           />
    </resultMap>

    <sql id="selectAiLegalKnowledgeVo">
        select knowledge_id, title, content, category_id, law_article, law_name, article_no,
               issuing_authority, effective_date, valid_status, source_url, publish_version,
               source, keywords, view_count, status, audit_status, audit_by, audit_time, audit_remark,
               create_by, create_time, update_by, update_time, remark
        from ai_legal_knowledge
    </sql>
    
    <select id="selectAiLegalKnowledgeList" parameterType="AiLegalKnowledge" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        <where>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="keywords != null  and keywords != ''"> and keywords like concat('%', #{keywords}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="auditStatus != null and auditStatus != ''"> and audit_status = #{auditStatus}</if>
            <if test="validStatus != null and validStatus != ''"> and valid_status = #{validStatus}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectAiLegalKnowledgeById" parameterType="Long" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        where knowledge_id = #{knowledgeId}
    </select>
    
    <select id="selectAiLegalKnowledgeByTitle" parameterType="String" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        where title = #{title}
        limit 1
    </select>
    
    <select id="selectAiLegalKnowledgeByCategoryId" parameterType="Long" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        where category_id = #{categoryId}
        order by view_count desc
    </select>
    
    <select id="searchAiLegalKnowledge" parameterType="String" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        where status = '0' and audit_status = '1'
        and (valid_status is null or valid_status = '1')
        and (title like concat('%', #{keyword}, '%') or keywords like concat('%', #{keyword}, '%') or content like concat('%', #{keyword}, '%'))
        order by view_count desc
    </select>

    <!-- T3：加载启用、审核通过且现行有效的知识（供分块/向量化；F7 失效法条过滤） -->
    <select id="selectIndexableKnowledge" resultMap="AiLegalKnowledgeResult">
        <include refid="selectAiLegalKnowledgeVo"/>
        where status = '0' and audit_status = '1'
        and (valid_status is null or valid_status = '1')
    </select>
        
    <insert id="insertAiLegalKnowledge" parameterType="AiLegalKnowledge" useGeneratedKeys="true" keyProperty="knowledgeId">
        insert into ai_legal_knowledge
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="lawArticle != null and lawArticle != ''">law_article,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="keywords != null and keywords != ''">keywords,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="status != null">status,</if>
            <if test="auditStatus != null">audit_status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="lawName != null">law_name,</if>
            <if test="articleNo != null">article_no,</if>
            <if test="issuingAuthority != null">issuing_authority,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="validStatus != null">valid_status,</if>
            <if test="sourceUrl != null">source_url,</if>
            <if test="publishVersion != null">publish_version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="lawArticle != null and lawArticle != ''">#{lawArticle},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="keywords != null and keywords != ''">#{keywords},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="status != null">#{status},</if>
            <if test="auditStatus != null">#{auditStatus},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="lawName != null">#{lawName},</if>
            <if test="articleNo != null">#{articleNo},</if>
            <if test="issuingAuthority != null">#{issuingAuthority},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="validStatus != null">#{validStatus},</if>
            <if test="sourceUrl != null">#{sourceUrl},</if>
            <if test="publishVersion != null">#{publishVersion},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateAiLegalKnowledge" parameterType="AiLegalKnowledge">
        update ai_legal_knowledge
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="lawArticle != null">law_article = #{lawArticle},</if>
            <if test="source != null">source = #{source},</if>
            <if test="keywords != null and keywords != ''">keywords = #{keywords},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status = #{auditStatus},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="lawName != null">law_name = #{lawName},</if>
            <if test="articleNo != null">article_no = #{articleNo},</if>
            <if test="issuingAuthority != null">issuing_authority = #{issuingAuthority},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="validStatus != null">valid_status = #{validStatus},</if>
            <if test="sourceUrl != null">source_url = #{sourceUrl},</if>
            <if test="publishVersion != null">publish_version = #{publishVersion},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where knowledge_id = #{knowledgeId}
    </update>

    <delete id="deleteAiLegalKnowledgeById" parameterType="Long">
        delete from ai_legal_knowledge where knowledge_id = #{knowledgeId}
    </delete>

    <delete id="deleteAiLegalKnowledgeByIds" parameterType="String">
        delete from ai_legal_knowledge where knowledge_id in 
        <foreach item="knowledgeId" collection="array" open="(" separator="," close=")">
            #{knowledgeId}
        </foreach>
    </delete>
</mapper>
