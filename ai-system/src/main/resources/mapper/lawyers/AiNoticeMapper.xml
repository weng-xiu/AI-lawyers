<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiNoticeMapper">

    <resultMap type="AiNotice" id="AiNoticeResult">
        <result property="noticeId"      column="notice_id"      />
        <result property="noticeTitle"   column="notice_title"   />
        <result property="noticeContent" column="notice_content" />
        <result property="noticeType"    column="notice_type"    />
        <result property="publishTime"   column="publish_time"   />
        <result property="status"        column="status"         />
        <result property="isTop"         column="is_top"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectAiNoticeVo">
        select notice_id, notice_title, notice_content, notice_type, publish_time, status, is_top,
               create_by, create_time, update_by, update_time, remark
        from ai_notice
    </sql>

    <select id="selectAiNoticeList" parameterType="AiNotice" resultMap="AiNoticeResult">
        <include refid="selectAiNoticeVo"/>
        <where>
            <if test="noticeTitle != null and noticeTitle != ''"> and notice_title like concat('%', #{noticeTitle}, '%')</if>
            <if test="noticeType != null and noticeType != ''"> and notice_type = #{noticeType}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="isTop != null and isTop != ''"> and is_top = #{isTop}</if>
        </where>
        order by field(is_top,'1','0'), publish_time desc, create_time desc
    </select>

    <select id="selectAiNoticeByNoticeId" parameterType="Long" resultMap="AiNoticeResult">
        <include refid="selectAiNoticeVo"/>
        where notice_id = #{noticeId}
    </select>

    <select id="selectPublishedNotices" parameterType="Integer" resultMap="AiNoticeResult">
        <include refid="selectAiNoticeVo"/>
        where status = '1'
        order by field(is_top,'1','0'), publish_time desc
        <if test="limit != null">
            limit #{limit}
        </if>
    </select>

    <insert id="insertAiNotice" parameterType="AiNotice" useGeneratedKeys="true" keyProperty="noticeId">
        insert into ai_notice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title,</if>
            <if test="noticeContent != null">notice_content,</if>
            <if test="noticeType != null">notice_type,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="status != null">status,</if>
            <if test="isTop != null">is_top,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">#{noticeTitle},</if>
            <if test="noticeContent != null">#{noticeContent},</if>
            <if test="noticeType != null">#{noticeType},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="status != null">#{status},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiNotice" parameterType="AiNotice">
        update ai_notice
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title = #{noticeTitle},</if>
            <if test="noticeContent != null">notice_content = #{noticeContent},</if>
            <if test="noticeType != null">notice_type = #{noticeType},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where notice_id = #{noticeId}
    </update>

    <delete id="deleteAiNoticeByNoticeId" parameterType="Long">
        delete from ai_notice where notice_id = #{noticeId}
    </delete>

    <delete id="deleteAiNoticeByNoticeIds" parameterType="String">
        delete from ai_notice where notice_id in
        <foreach item="noticeId" collection="array" open="(" separator="," close=")">
            #{noticeId}
        </foreach>
    </delete>
</mapper>
