<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiReturnVisitTaskMapper">

    <resultMap type="AiReturnVisitTask" id="AiReturnVisitTaskResult">
        <result property="taskId"       column="task_id"        />
        <result property="taskNo"       column="task_no"        />
        <result property="callerNumber" column="caller_number"  />
        <result property="callerName"   column="caller_name"    />
        <result property="planTime"     column="plan_time"      />
        <result property="actualTime"   column="actual_time"    />
        <result property="assignee"     column="assignee"       />
        <result property="status"       column="status"         />
        <result property="priority"     column="priority"       />
        <result property="visitResult"  column="visit_result"   />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>

    <sql id="selectAiReturnVisitTaskVo">
        select task_id, task_no, caller_number, caller_name, plan_time, actual_time, assignee, status,
               priority, visit_result, create_by, create_time, update_by, update_time, remark
        from ai_return_visit_task
    </sql>

    <select id="selectAiReturnVisitTaskList" parameterType="AiReturnVisitTask" resultMap="AiReturnVisitTaskResult">
        <include refid="selectAiReturnVisitTaskVo"/>
        <where>
            <if test="taskNo != null and taskNo != ''"> and task_no like concat('%', #{taskNo}, '%')</if>
            <if test="callerNumber != null and callerNumber != ''"> and caller_number like concat('%', #{callerNumber}, '%')</if>
            <if test="callerName != null and callerName != ''"> and caller_name like concat('%', #{callerName}, '%')</if>
            <if test="assignee != null and assignee != ''"> and assignee like concat('%', #{assignee}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="priority != null and priority != ''"> and priority = #{priority}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date(plan_time) &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and date(plan_time) &lt;= #{params.endTime}</if>
        </where>
        order by priority asc, plan_time asc
    </select>

    <select id="selectAiReturnVisitTaskByTaskId" parameterType="Long" resultMap="AiReturnVisitTaskResult">
        <include refid="selectAiReturnVisitTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectReturnVisitTaskStats" resultType="map">
        select count(*) as totalCount,
               sum(case when status = '0' then 1 else 0 end) as pendingCount,
               sum(case when status = '1' then 1 else 0 end) as completedCount,
               sum(case when status = '2' then 1 else 0 end) as overdueCount,
               sum(case when priority = '1' then 1 else 0 end) as highPriorityCount
        from ai_return_visit_task
    </select>

    <update id="markOverdueTasks" parameterType="java.util.Date">
        update ai_return_visit_task
        set status = '2',
            update_time = sysdate()
        where status = '0'
          and plan_time is not null
          and plan_time &lt; #{now}
    </update>

    <insert id="insertAiReturnVisitTask" parameterType="AiReturnVisitTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into ai_return_visit_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskNo != null and taskNo != ''">task_no,</if>
            <if test="callerNumber != null and callerNumber != ''">caller_number,</if>
            <if test="callerName != null and callerName != ''">caller_name,</if>
            <if test="planTime != null">plan_time,</if>
            <if test="actualTime != null">actual_time,</if>
            <if test="assignee != null and assignee != ''">assignee,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="priority != null and priority != ''">priority,</if>
            <if test="visitResult != null">visit_result,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskNo != null and taskNo != ''">#{taskNo},</if>
            <if test="callerNumber != null and callerNumber != ''">#{callerNumber},</if>
            <if test="callerName != null and callerName != ''">#{callerName},</if>
            <if test="planTime != null">#{planTime},</if>
            <if test="actualTime != null">#{actualTime},</if>
            <if test="assignee != null and assignee != ''">#{assignee},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="priority != null and priority != ''">#{priority},</if>
            <if test="visitResult != null">#{visitResult},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiReturnVisitTask" parameterType="AiReturnVisitTask">
        update ai_return_visit_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskNo != null and taskNo != ''">task_no = #{taskNo},</if>
            <if test="callerNumber != null and callerNumber != ''">caller_number = #{callerNumber},</if>
            <if test="callerName != null and callerName != ''">caller_name = #{callerName},</if>
            <if test="planTime != null">plan_time = #{planTime},</if>
            <if test="actualTime != null">actual_time = #{actualTime},</if>
            <if test="assignee != null and assignee != ''">assignee = #{assignee},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="visitResult != null">visit_result = #{visitResult},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteAiReturnVisitTaskByTaskId" parameterType="Long">
        delete from ai_return_visit_task where task_id = #{taskId}
    </delete>

    <delete id="deleteAiReturnVisitTaskByTaskIds" parameterType="String">
        delete from ai_return_visit_task where task_id in
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>
