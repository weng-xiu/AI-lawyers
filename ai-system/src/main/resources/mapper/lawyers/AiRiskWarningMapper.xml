<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiRiskWarningMapper">

    <resultMap type="AiRiskWarning" id="AiRiskWarningResult">
        <result property="warningId"      column="warning_id"      />
        <result property="warningType"    column="warning_type"    />
        <result property="warningLevel"   column="warning_level"   />
        <result property="sourceType"     column="source_type"     />
        <result property="sourceId"       column="source_id"       />
        <result property="ruleId"         column="rule_id"         />
        <result property="suggestTransferType" column="suggest_transfer_type" />
        <result property="transferId"     column="transfer_id"     />
        <result property="ruleName"       column="rule_name"       />
        <result property="ruleSuggestOrgId" column="rule_suggest_org_id" />
        <result property="ticketNo"       column="ticket_no"       />
        <result property="content"        column="content"         />
        <result property="customerName"   column="customer_name"   />
        <result property="status"         column="status"          />
        <result property="handlerName"    column="handler_name"    />
        <result property="handlerId"      column="handler_id"      />
        <result property="handleResult"   column="handle_result"   />
        <result property="handleTime"     column="handle_time"     />
        <result property="triggerTime"    column="trigger_time"    />
        <result property="createTime"     column="create_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <!-- F3：LEFT JOIN 规则表带出命中规则名与建议条线（预警快照优先，回退规则当前值）；LEFT JOIN 转办流水带出转办工单号 -->
    <sql id="selectAiRiskWarningVo">
        select w.warning_id, w.warning_type, w.warning_level, w.source_type, w.source_id,
               w.rule_id, coalesce(w.suggest_transfer_type, r.suggest_transfer_type) as suggest_transfer_type,
               w.transfer_id, r.rule_name, r.suggest_org_id as rule_suggest_org_id, tt.ticket_no,
               w.content, w.customer_name, w.status, w.handler_name, w.handler_id,
               w.handle_result, w.handle_time, w.trigger_time, w.create_time, w.remark
        from ai_risk_warning w
        left join ai_risk_warning_rule r on r.rule_id = w.rule_id
        left join ai_ticket_transfer tt on tt.transfer_id = w.transfer_id
    </sql>

    <select id="selectAiRiskWarningList" parameterType="AiRiskWarning" resultMap="AiRiskWarningResult">
        <include refid="selectAiRiskWarningVo"/>
        <where>
            <if test="warningType != null and warningType != ''"> and w.warning_type = #{warningType}</if>
            <if test="warningLevel != null and warningLevel != ''"> and w.warning_level = #{warningLevel}</if>
            <if test="status != null and status != ''"> and w.status = #{status}</if>
            <if test="customerName != null and customerName != ''"> and w.customer_name like concat('%', #{customerName}, '%')</if>
            <if test="handlerId != null"> and w.handler_id = #{handlerId}</if>
            <if test="suggestTransferType != null and suggestTransferType != ''"> and coalesce(w.suggest_transfer_type, r.suggest_transfer_type) = #{suggestTransferType}</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and w.trigger_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and w.trigger_time &lt;= #{params.endTime}
            </if>
        </where>
        order by w.trigger_time desc, w.create_time desc
    </select>

    <select id="selectAiRiskWarningByWarningId" parameterType="Long" resultMap="AiRiskWarningResult">
        <include refid="selectAiRiskWarningVo"/>
        where w.warning_id = #{warningId}
    </select>

    <select id="selectByIdForUpdate" parameterType="Long" resultMap="AiRiskWarningResult">
        <include refid="selectAiRiskWarningVo"/>
        where w.warning_id = #{warningId}
        for update
    </select>

    <insert id="insertAiRiskWarning" parameterType="AiRiskWarning" useGeneratedKeys="true" keyProperty="warningId">
        insert into ai_risk_warning
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="warningType != null and warningType != ''">warning_type,</if>
            <if test="warningLevel != null">warning_level,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="ruleId != null">rule_id,</if>
            <if test="suggestTransferType != null">suggest_transfer_type,</if>
            <if test="transferId != null">transfer_id,</if>
            <if test="content != null">content,</if>
            <if test="customerName != null">customer_name,</if>
            <if test="status != null">status,</if>
            <if test="handlerName != null">handler_name,</if>
            <if test="handlerId != null">handler_id,</if>
            <if test="handleResult != null">handle_result,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="triggerTime != null">trigger_time,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="warningType != null and warningType != ''">#{warningType},</if>
            <if test="warningLevel != null">#{warningLevel},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="ruleId != null">#{ruleId},</if>
            <if test="suggestTransferType != null">#{suggestTransferType},</if>
            <if test="transferId != null">#{transferId},</if>
            <if test="content != null">#{content},</if>
            <if test="customerName != null">#{customerName},</if>
            <if test="status != null">#{status},</if>
            <if test="handlerName != null">#{handlerName},</if>
            <if test="handlerId != null">#{handlerId},</if>
            <if test="handleResult != null">#{handleResult},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="triggerTime != null">#{triggerTime},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiRiskWarning" parameterType="AiRiskWarning">
        update ai_risk_warning
        <trim prefix="SET" suffixOverrides=",">
            <if test="warningType != null and warningType != ''">warning_type = #{warningType},</if>
            <if test="warningLevel != null">warning_level = #{warningLevel},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="customerName != null">customer_name = #{customerName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="handlerName != null">handler_name = #{handlerName},</if>
            <if test="handlerId != null">handler_id = #{handlerId},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="triggerTime != null">trigger_time = #{triggerTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where warning_id = #{warningId}
    </update>

    <!-- F3：一键转办后回写转办流水ID（仅当未回写过，防并发重复转办） -->
    <update id="updateTransferRef">
        update ai_risk_warning
        set transfer_id = #{transferId}
        where warning_id = #{warningId} and transfer_id is null
    </update>

    <delete id="deleteAiRiskWarningByWarningId" parameterType="Long">
        delete from ai_risk_warning where warning_id = #{warningId}
    </delete>

    <delete id="deleteAiRiskWarningByWarningIds" parameterType="String">
        delete from ai_risk_warning where warning_id in
        <foreach item="warningId" collection="array" open="(" separator="," close=")">
            #{warningId}
        </foreach>
    </delete>
</mapper>
