<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.AiSlaPolicyMapper">

    <resultMap type="AiSlaPolicy" id="AiSlaPolicyResult">
        <result property="policyId"        column="policy_id"        />
        <result property="policyName"      column="policy_name"      />
        <result property="bizType"         column="biz_type"         />
        <result property="priority"        column="priority"         />
        <result property="respondMinutes"  column="respond_minutes"  />
        <result property="resolveMinutes"  column="resolve_minutes"  />
        <result property="warnThreshold"   column="warn_threshold"   />
        <result property="escalateRoles"   column="escalate_roles"   />
        <result property="status"          column="status"           />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>

    <sql id="selectAiSlaPolicyVo">
        select policy_id, policy_name, biz_type, priority, respond_minutes, resolve_minutes,
               warn_threshold, escalate_roles, status, create_by, create_time, update_by, update_time, remark
        from ai_sla_policy
    </sql>

    <select id="selectAiSlaPolicyList" parameterType="AiSlaPolicy" resultMap="AiSlaPolicyResult">
        <include refid="selectAiSlaPolicyVo"/>
        <where>
            <if test="policyName != null and policyName != ''"> and policy_name like concat('%', #{policyName}, '%')</if>
            <if test="bizType != null and bizType != ''"> and biz_type = #{bizType}</if>
            <if test="priority != null and priority != ''"> and priority = #{priority}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by biz_type, priority
    </select>

    <select id="selectAiSlaPolicyByPolicyId" parameterType="Long" resultMap="AiSlaPolicyResult">
        <include refid="selectAiSlaPolicyVo"/>
        where policy_id = #{policyId}
    </select>

    <!-- 精确匹配优先，未配置时回退同业务类型普通优先级，再回退 TICKET 普通优先级 -->
    <select id="selectMatchedPolicy" resultMap="AiSlaPolicyResult">
        <include refid="selectAiSlaPolicyVo"/>
        where status = '0'
        order by
          case when biz_type = #{bizType} and priority = #{priority} then 0
               when biz_type = #{bizType} and priority = '2' then 1
               when biz_type = 'TICKET' and priority = #{priority} then 2
               when biz_type = 'TICKET' and priority = '2' then 3
               else 4 end,
          policy_id
        limit 1
    </select>

    <insert id="insertAiSlaPolicy" parameterType="AiSlaPolicy" useGeneratedKeys="true" keyProperty="policyId">
        insert into ai_sla_policy
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="policyName != null and policyName != ''">policy_name,</if>
            <if test="bizType != null and bizType != ''">biz_type,</if>
            <if test="priority != null and priority != ''">priority,</if>
            <if test="respondMinutes != null">respond_minutes,</if>
            <if test="resolveMinutes != null">resolve_minutes,</if>
            <if test="warnThreshold != null">warn_threshold,</if>
            <if test="escalateRoles != null">escalate_roles,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="policyName != null and policyName != ''">#{policyName},</if>
            <if test="bizType != null and bizType != ''">#{bizType},</if>
            <if test="priority != null and priority != ''">#{priority},</if>
            <if test="respondMinutes != null">#{respondMinutes},</if>
            <if test="resolveMinutes != null">#{resolveMinutes},</if>
            <if test="warnThreshold != null">#{warnThreshold},</if>
            <if test="escalateRoles != null">#{escalateRoles},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiSlaPolicy" parameterType="AiSlaPolicy">
        update ai_sla_policy
        <trim prefix="SET" suffixOverrides=",">
            <if test="policyName != null and policyName != ''">policy_name = #{policyName},</if>
            <if test="bizType != null and bizType != ''">biz_type = #{bizType},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="respondMinutes != null">respond_minutes = #{respondMinutes},</if>
            <if test="resolveMinutes != null">resolve_minutes = #{resolveMinutes},</if>
            <if test="warnThreshold != null">warn_threshold = #{warnThreshold},</if>
            <if test="escalateRoles != null">escalate_roles = #{escalateRoles},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where policy_id = #{policyId}
    </update>

    <delete id="deleteAiSlaPolicyByPolicyIds" parameterType="String">
        delete from ai_sla_policy where policy_id in
        <foreach item="policyId" collection="array" open="(" separator="," close=")">
            #{policyId}
        </foreach>
    </delete>
</mapper>
