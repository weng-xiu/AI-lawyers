<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.forecast.AiForecastCalendarMapper">

    <resultMap type="AiForecastCalendar" id="AiForecastCalendarResult">
        <result property="calendarId"   column="calendar_id"   />
        <result property="calendarDate" column="calendar_date" />
        <result property="dayType"      column="day_type"      />
        <result property="dayName"      column="day_name"      />
        <result property="coefficient"  column="coefficient"   />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="calendarColumns">
        select calendar_id, calendar_date, day_type, day_name, coefficient, status,
               create_by, create_time, update_by, update_time, remark
        from ai_forecast_calendar
    </sql>

    <select id="selectCalendarList" parameterType="AiForecastCalendar" resultMap="AiForecastCalendarResult">
        <include refid="calendarColumns"/>
        <where>
            <if test="dayType != null and dayType != ''"> and day_type = #{dayType}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="dayName != null and dayName != ''"> and day_name like concat('%', #{dayName}, '%')</if>
            <if test="beginDate != null"> and calendar_date &gt;= #{beginDate}</if>
            <if test="endDate != null"> and calendar_date &lt;= #{endDate}</if>
        </where>
        order by calendar_date desc
    </select>

    <select id="selectCalendarById" parameterType="Long" resultMap="AiForecastCalendarResult">
        <include refid="calendarColumns"/>
        where calendar_id = #{calendarId}
    </select>

    <select id="selectActiveBetween" resultMap="AiForecastCalendarResult">
        <include refid="calendarColumns"/>
        where status = '0' and calendar_date &gt;= #{beginDate} and calendar_date &lt;= #{endDate}
    </select>

    <insert id="insertCalendar" parameterType="AiForecastCalendar" useGeneratedKeys="true" keyProperty="calendarId">
        insert into ai_forecast_calendar
        <trim prefix="(" suffix=")" suffixOverrides=",">
            calendar_date,
            <if test="dayType != null and dayType != ''">day_type,</if>
            <if test="dayName != null">day_name,</if>
            <if test="coefficient != null">coefficient,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{calendarDate},
            <if test="dayType != null and dayType != ''">#{dayType},</if>
            <if test="dayName != null">#{dayName},</if>
            <if test="coefficient != null">#{coefficient},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateCalendar" parameterType="AiForecastCalendar">
        update ai_forecast_calendar
        <trim prefix="SET" suffixOverrides=",">
            <if test="calendarDate != null">calendar_date = #{calendarDate},</if>
            <if test="dayType != null and dayType != ''">day_type = #{dayType},</if>
            <if test="dayName != null">day_name = #{dayName},</if>
            <if test="coefficient != null">coefficient = #{coefficient},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where calendar_id = #{calendarId}
    </update>

    <delete id="deleteCalendarByIds" parameterType="String">
        delete from ai_forecast_calendar where calendar_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
