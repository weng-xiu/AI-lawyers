<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.ivr.AiIvrFlowMapper">

    <resultMap type="AiIvrFlow" id="AiIvrFlowResult">
        <result property="flowId"        column="flow_id"        />
        <result property="flowName"      column="flow_name"      />
        <result property="flowCode"      column="flow_code"      />
        <result property="description"   column="description"    />
        <result property="flowData"      column="flow_data"      />
        <result property="status"        column="status"         />
        <result property="version"       column="version"        />
        <result property="category"      column="category"       />
        <result property="isDefault"     column="is_default"     />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectAiIvrFlowVo">
        select flow_id, flow_name, flow_code, description, flow_data, status, version, category, is_default, create_by, create_time, update_by, update_time, remark from ai_ivr_flow
    </sql>

    <select id="selectAiIvrFlowList" parameterType="AiIvrFlow" resultMap="AiIvrFlowResult">
        <include refid="selectAiIvrFlowVo"/>
        <where>
            <if test="flowName != null and flowName != ''"> and flow_name like concat('%', #{flowName}, '%')</if>
            <if test="flowCode != null and flowCode != ''"> and flow_code = #{flowCode}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="category != null and category != ''"> and category = #{category}</if>
            <if test="isDefault != null and isDefault != ''"> and is_default = #{isDefault}</if>
        </where>
        order by is_default desc, create_time desc
    </select>

    <select id="selectAiIvrFlowByFlowId" parameterType="Long" resultMap="AiIvrFlowResult">
        <include refid="selectAiIvrFlowVo"/>
        where flow_id = #{flowId}
    </select>

    <select id="selectDefaultFlow" resultMap="AiIvrFlowResult">
        <include refid="selectAiIvrFlowVo"/>
        where is_default = '1'
        limit 1
    </select>

    <select id="selectPublishedFlows" resultMap="AiIvrFlowResult">
        <include refid="selectAiIvrFlowVo"/>
        where status = '1'
        order by create_time desc
    </select>

    <insert id="insertAiIvrFlow" parameterType="AiIvrFlow" useGeneratedKeys="true" keyProperty="flowId">
        insert into ai_ivr_flow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="flowName != null and flowName != ''">flow_name,</if>
            <if test="flowCode != null and flowCode != ''">flow_code,</if>
            <if test="description != null">description,</if>
            <if test="flowData != null">flow_data,</if>
            <if test="status != null">status,</if>
            <if test="version != null">version,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="flowName != null and flowName != ''">#{flowName},</if>
            <if test="flowCode != null and flowCode != ''">#{flowCode},</if>
            <if test="description != null">#{description},</if>
            <if test="flowData != null">#{flowData},</if>
            <if test="status != null">#{status},</if>
            <if test="version != null">#{version},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiIvrFlow" parameterType="AiIvrFlow">
        update ai_ivr_flow
        <trim prefix="SET" suffixOverrides=",">
            <if test="flowName != null and flowName != ''">flow_name = #{flowName},</if>
            <if test="flowCode != null and flowCode != ''">flow_code = #{flowCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="flowData != null">flow_data = #{flowData},</if>
            <if test="status != null">status = #{status},</if>
            <if test="version != null">version = #{version},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where flow_id = #{flowId}
    </update>

    <delete id="deleteAiIvrFlowByFlowId" parameterType="Long">
        delete from ai_ivr_flow where flow_id = #{flowId}
    </delete>

    <delete id="deleteAiIvrFlowByFlowIds" parameterType="String">
        delete from ai_ivr_flow where flow_id in
        <foreach item="flowId" collection="array" open="(" separator="," close=")">
            #{flowId}
        </foreach>
    </delete>
</mapper>
