<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.outbound.AiOutboundTaskMapper">

    <resultMap type="AiOutboundTask" id="AiOutboundTaskResult">
        <result property="taskId"           column="task_id"           />
        <result property="taskName"         column="task_name"         />
        <result property="taskNo"           column="task_no"           />
        <result property="taskType"         column="task_type"         />
        <result property="callerNumber"     column="caller_number"     />
        <result property="ivrFlowId"        column="ivr_flow_id"        />
        <result property="ivrFlowName"      column="ivr_flow_name"      />
        <result property="startTime"        column="start_time"        />
        <result property="endTime"          column="end_time"          />
        <result property="totalCount"       column="total_count"       />
        <result property="completedCount"   column="completed_count"   />
        <result property="answeredCount"    column="answered_count"    />
        <result property="failedCount"      column="failed_count"      />
        <result property="noAnswerCount"    column="no_answer_count"   />
        <result property="status"           column="status"            />
        <result property="priority"         column="priority"          />
        <result property="retryCount"       column="retry_count"       />
        <result property="retryInterval"    column="retry_interval"    />
        <result property="maxConcurrent"    column="max_concurrent"    />
        <result property="callerName"       column="caller_name"       />
        <result property="callerDeptId"     column="caller_dept_id"    />
        <result property="description"      column="description"       />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectAiOutboundTaskVo">
        select task_id, task_name, task_no, task_type, caller_number, ivr_flow_id, ivr_flow_name,
               start_time, end_time, total_count, completed_count, answered_count, failed_count,
               no_answer_count, status, priority, retry_count, retry_interval, max_concurrent,
               caller_name, caller_dept_id, description, create_by, create_time, update_by, update_time, remark
        from ai_outbound_task
    </sql>

    <select id="selectAiOutboundTaskList" parameterType="AiOutboundTask" resultMap="AiOutboundTaskResult">
        <include refid="selectAiOutboundTaskVo"/>
        <where>
            <if test="taskName != null and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectAiOutboundTaskByTaskId" parameterType="Long" resultMap="AiOutboundTaskResult">
        <include refid="selectAiOutboundTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectAiOutboundTaskByTaskNo" parameterType="String" resultMap="AiOutboundTaskResult">
        <include refid="selectAiOutboundTaskVo"/>
        where task_no = #{taskNo}
    </select>

    <select id="selectRunningTasks" resultMap="AiOutboundTaskResult">
        <include refid="selectAiOutboundTaskVo"/>
        where status = '1'
        order by priority desc, create_time asc
    </select>

    <insert id="insertAiOutboundTask" parameterType="AiOutboundTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into ai_outbound_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="taskNo != null and taskNo != ''">task_no,</if>
            <if test="taskType != null and taskType != ''">task_type,</if>
            <if test="callerNumber != null and callerNumber != ''">caller_number,</if>
            <if test="ivrFlowId != null">ivr_flow_id,</if>
            <if test="ivrFlowName != null and ivrFlowName != ''">ivr_flow_name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="totalCount != null">total_count,</if>
            <if test="completedCount != null">completed_count,</if>
            <if test="answeredCount != null">answered_count,</if>
            <if test="failedCount != null">failed_count,</if>
            <if test="noAnswerCount != null">no_answer_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="priority != null">priority,</if>
            <if test="retryCount != null">retry_count,</if>
            <if test="retryInterval != null">retry_interval,</if>
            <if test="maxConcurrent != null">max_concurrent,</if>
            <if test="callerName != null and callerName != ''">caller_name,</if>
            <if test="callerDeptId != null">caller_dept_id,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="taskNo != null and taskNo != ''">#{taskNo},</if>
            <if test="taskType != null and taskType != ''">#{taskType},</if>
            <if test="callerNumber != null and callerNumber != ''">#{callerNumber},</if>
            <if test="ivrFlowId != null">#{ivrFlowId},</if>
            <if test="ivrFlowName != null and ivrFlowName != ''">#{ivrFlowName},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="totalCount != null">#{totalCount},</if>
            <if test="completedCount != null">#{completedCount},</if>
            <if test="answeredCount != null">#{answeredCount},</if>
            <if test="failedCount != null">#{failedCount},</if>
            <if test="noAnswerCount != null">#{noAnswerCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="priority != null">#{priority},</if>
            <if test="retryCount != null">#{retryCount},</if>
            <if test="retryInterval != null">#{retryInterval},</if>
            <if test="maxConcurrent != null">#{maxConcurrent},</if>
            <if test="callerName != null and callerName != ''">#{callerName},</if>
            <if test="callerDeptId != null">#{callerDeptId},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiOutboundTask" parameterType="AiOutboundTask">
        update ai_outbound_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="taskNo != null and taskNo != ''">task_no = #{taskNo},</if>
            <if test="taskType != null and taskType != ''">task_type = #{taskType},</if>
            <if test="callerNumber != null and callerNumber != ''">caller_number = #{callerNumber},</if>
            <if test="ivrFlowId != null">ivr_flow_id = #{ivrFlowId},</if>
            <if test="ivrFlowName != null and ivrFlowName != ''">ivr_flow_name = #{ivrFlowName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="completedCount != null">completed_count = #{completedCount},</if>
            <if test="answeredCount != null">answered_count = #{answeredCount},</if>
            <if test="failedCount != null">failed_count = #{failedCount},</if>
            <if test="noAnswerCount != null">no_answer_count = #{noAnswerCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="retryInterval != null">retry_interval = #{retryInterval},</if>
            <if test="maxConcurrent != null">max_concurrent = #{maxConcurrent},</if>
            <if test="callerName != null and callerName != ''">caller_name = #{callerName},</if>
            <if test="callerDeptId != null">caller_dept_id = #{callerDeptId},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where task_id = #{taskId}
    </update>

    <update id="updateTaskStatus" parameterType="AiOutboundTask">
        update ai_outbound_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where task_id = #{taskId}
    </update>

    <update id="incrementCompletedCount" parameterType="Long">
        update ai_outbound_task set completed_count = completed_count + 1, update_time = sysdate() where task_id = #{taskId}
    </update>

    <update id="incrementAnsweredCount" parameterType="Long">
        update ai_outbound_task set answered_count = answered_count + 1, update_time = sysdate() where task_id = #{taskId}
    </update>

    <update id="incrementFailedCount" parameterType="Long">
        update ai_outbound_task set failed_count = failed_count + 1, update_time = sysdate() where task_id = #{taskId}
    </update>

    <update id="incrementNoAnswerCount" parameterType="Long">
        update ai_outbound_task set no_answer_count = no_answer_count + 1, update_time = sysdate() where task_id = #{taskId}
    </update>

    <delete id="deleteAiOutboundTaskByTaskId" parameterType="Long">
        delete from ai_outbound_task where task_id = #{taskId}
    </delete>

    <delete id="deleteAiOutboundTaskByTaskIds" parameterType="String">
        delete from ai_outbound_task where task_id in
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>
