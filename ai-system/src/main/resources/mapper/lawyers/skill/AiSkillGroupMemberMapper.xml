<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.skill.AiSkillGroupMemberMapper">

    <resultMap type="AiSkillGroupMember" id="AiSkillGroupMemberResult">
        <result property="id"            column="id"             />
        <result property="groupId"       column="group_id"       />
        <result property="agentId"       column="agent_id"       />
        <result property="skillLevel"    column="skill_level"    />
        <result property="priority"      column="priority"       />
        <result property="maxConcurrent" column="max_concurrent" />
        <result property="status"        column="status"         />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="agentName"     column="agent_name"     />
        <result property="agentStatus"   column="agent_status"   />
        <result property="callStatus"    column="call_status"    />
    </resultMap>

    <sql id="selectMemberVo">
        select m.id, m.group_id, m.agent_id, m.skill_level, m.priority, m.max_concurrent, m.status,
               m.create_time, m.update_time, a.agent_name, a.status as agent_status, a.call_status
        from ai_skill_group_member m
        left join ai_call_agent_status a on a.agent_id = m.agent_id
    </sql>

    <select id="selectById" parameterType="Long" resultMap="AiSkillGroupMemberResult">
        <include refid="selectMemberVo"/>
        where m.id = #{id}
    </select>

    <select id="selectMemberList" parameterType="AiSkillGroupMember" resultMap="AiSkillGroupMemberResult">
        <include refid="selectMemberVo"/>
        <where>
            <if test="groupId != null"> and m.group_id = #{groupId}</if>
            <if test="agentId != null"> and m.agent_id = #{agentId}</if>
            <if test="status != null and status != ''"> and m.status = #{status}</if>
            <if test="skillLevel != null"> and m.skill_level = #{skillLevel}</if>
        </where>
        order by m.skill_level desc, m.priority desc, m.id asc
    </select>

    <!-- 可用坐席：成员启用 + 坐席在线(status=1) + 空闲(call_status=0)，按等级优先级排序 -->
    <select id="selectAvailableByGroupId" parameterType="Long" resultMap="AiSkillGroupMemberResult">
        <include refid="selectMemberVo"/>
        where m.group_id = #{groupId}
          and m.status = '1'
          and a.status = '1'
          and a.call_status = '0'
        order by m.skill_level desc, m.priority desc, m.id asc
    </select>

    <select id="countTodayCompletedByAgent" resultType="java.lang.Integer">
        select count(1) from ai_call_record
        where agent_id = #{agentId}
          and status = '1'
          and date(create_time) = curdate()
    </select>

    <select id="selectLastCallStartTime" resultType="java.util.Date">
        select max(call_start_time) from ai_call_agent_status
        where agent_id = #{agentId}
    </select>

    <!-- T1-5 批量聚合候选坐席负载：最近通话开始时间 + 今日完成通话数，一条 SQL 替代逐坐席 N+1 查询 -->
    <resultMap id="AgentLoadStatResult" type="ai.lawyers.system.domain.lawyers.skill.AgentLoadStat">
        <result property="agentId"           column="agent_id"           />
        <result property="lastCallStartTime" column="last_call_start_time" />
        <result property="todayCompleted"    column="today_completed"    />
    </resultMap>
    <select id="selectLoadStatsByAgentIds" resultMap="AgentLoadStatResult">
        select a.agent_id,
               a.call_start_time as last_call_start_time,
               (select count(1) from ai_call_record r
                 where r.agent_id = a.agent_id and r.status = '1'
                   and date(r.create_time) = curdate()) as today_completed
        from ai_call_agent_status a
        where a.agent_id in
        <foreach item="id" collection="agentIds" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <insert id="insertMember" parameterType="AiSkillGroupMember" useGeneratedKeys="true" keyProperty="id">
        insert into ai_skill_group_member
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupId != null">group_id,</if>
            <if test="agentId != null">agent_id,</if>
            <if test="skillLevel != null">skill_level,</if>
            <if test="priority != null">priority,</if>
            <if test="maxConcurrent != null">max_concurrent,</if>
            <if test="status != null and status != ''">status,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupId != null">#{groupId},</if>
            <if test="agentId != null">#{agentId},</if>
            <if test="skillLevel != null">#{skillLevel},</if>
            <if test="priority != null">#{priority},</if>
            <if test="maxConcurrent != null">#{maxConcurrent},</if>
            <if test="status != null and status != ''">#{status},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateMember" parameterType="AiSkillGroupMember">
        update ai_skill_group_member
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupId != null">group_id = #{groupId},</if>
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="skillLevel != null">skill_level = #{skillLevel},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="maxConcurrent != null">max_concurrent = #{maxConcurrent},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteByIds" parameterType="String">
        delete from ai_skill_group_member where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
