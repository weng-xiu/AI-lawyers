<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.lawyers.system.mapper.lawyers.sms.AiSmsTemplateMapper">

    <resultMap type="AiSmsTemplate" id="AiSmsTemplateResult">
        <result property="templateId"           column="template_id"            />
        <result property="templateName"         column="template_name"          />
        <result property="providerTemplateCode" column="provider_template_code" />
        <result property="content"              column="content"                />
        <result property="sceneType"            column="scene_type"             />
        <result property="configId"             column="config_id"              />
        <result property="status"               column="status"                 />
        <result property="createBy"             column="create_by"              />
        <result property="createTime"           column="create_time"            />
        <result property="updateBy"             column="update_by"              />
        <result property="updateTime"           column="update_time"            />
        <result property="remark"               column="remark"                 />
        <result property="configName"           column="config_name"            />
    </resultMap>

    <sql id="selectTemplateVo">
        select t.template_id, t.template_name, t.provider_template_code, t.content, t.scene_type,
               t.config_id, t.status, t.create_by, t.create_time, t.update_by, t.update_time, t.remark,
               c.config_name
        from ai_sms_template t
        left join ai_sms_config c on c.config_id = t.config_id
    </sql>

    <select id="selectAiSmsTemplateList" parameterType="AiSmsTemplate" resultMap="AiSmsTemplateResult">
        <include refid="selectTemplateVo"/>
        <where>
            <if test="templateName != null and templateName != ''"> and t.template_name like concat('%', #{templateName}, '%')</if>
            <if test="sceneType != null and sceneType != ''"> and t.scene_type = #{sceneType}</if>
            <if test="configId != null"> and t.config_id = #{configId}</if>
            <if test="status != null and status != ''"> and t.status = #{status}</if>
        </where>
        order by t.template_id asc
    </select>

    <select id="selectAiSmsTemplateByTemplateId" parameterType="Long" resultMap="AiSmsTemplateResult">
        <include refid="selectTemplateVo"/>
        where t.template_id = #{templateId}
    </select>

    <insert id="insertAiSmsTemplate" parameterType="AiSmsTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into ai_sms_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="providerTemplateCode != null">provider_template_code,</if>
            <if test="content != null">content,</if>
            <if test="sceneType != null and sceneType != ''">scene_type,</if>
            <if test="configId != null">config_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="providerTemplateCode != null">#{providerTemplateCode},</if>
            <if test="content != null">#{content},</if>
            <if test="sceneType != null and sceneType != ''">#{sceneType},</if>
            <if test="configId != null">#{configId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiSmsTemplate" parameterType="AiSmsTemplate">
        update ai_sms_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="providerTemplateCode != null">provider_template_code = #{providerTemplateCode},</if>
            <if test="content != null">content = #{content},</if>
            <if test="sceneType != null and sceneType != ''">scene_type = #{sceneType},</if>
            <if test="configId != null">config_id = #{configId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where template_id = #{templateId}
    </update>

    <delete id="deleteAiSmsTemplateByTemplateIds" parameterType="String">
        delete from ai_sms_template where template_id in
        <foreach item="templateId" collection="array" open="(" separator="," close=")">#{templateId}</foreach>
    </delete>

</mapper>
