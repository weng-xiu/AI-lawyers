# 页面标题
VUE_APP_TITLE = 广东12348公共法律服务热线

# 开发环境配置
ENV = 'development'

# AI律师管理系统/开发环境
VUE_APP_BASE_API = '/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 浏览器 WebRTC SIP 软电话开关
# true  = 签入后自动向 FreeSWITCH 注册 SIP 分机（需要本地/测试环境部署 FreeSWITCH）
# false = 不注册 SIP 分机，仅保留业务 WebSocket 通道（坐席可使用硬件话机/桌面软电话）
#         适用于本地开发未部署 FreeSWITCH 的场景，避免控制台持续报 5066 连接错误
VUE_APP_SIP_ENABLED = false

# FreeSWITCH WebSocket SIP 地址（仅在 VUE_APP_SIP_ENABLED=true 时生效）
VUE_APP_SIP_WS_URL = 'ws://localhost:5066'
VUE_APP_SIP_DOMAIN = '198.18.0.1'
VUE_APP_SIP_PASSWORD = '1234'
