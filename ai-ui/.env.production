# 页面标题
VUE_APP_TITLE = 广东12348公共法律服务热线

# 生产环境配置
ENV = 'production'

# AI律师管理系统/生产环境
VUE_APP_BASE_API = '/prod-api'

# 浏览器 SIP 软电话开关（生产环境启用，需部署 FreeSWITCH 并开放 wss）
VUE_APP_SIP_ENABLED = true
VUE_APP_SIP_WS_URL = 'wss://12348.example.gov.cn:7443/ws'
VUE_APP_SIP_DOMAIN = '12348.example.gov.cn'
VUE_APP_SIP_PASSWORD = '1234'
