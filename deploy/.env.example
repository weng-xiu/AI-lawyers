# =====================================================================
# 生产环境变量样例（复制为 deploy/.env 后逐项替换；.env 不入库）
#
# 生成强随机值：
#   openssl rand -base64 32
#
# 开启 APP_SECURITY_GUARD=true 后，deploy.sh / deploy.ps1 会先执行
# 前置检查（deploy/preflight-prod.sh），后端启动时还会再校验一次。
# =====================================================================

# ---- 生产安全自检总开关 ----
APP_SECURITY_GUARD=true

# ---- 数据库（后端使用独立业务账号，禁止 root）----
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_USER=ai_law
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_USERNAME=ai_law
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- JWT / 凭据加密根密钥 ----
TOKEN_SECRET=CHANGE_ME_32_BYTES_RANDOM
APP_SECRET_KEY=CHANGE_ME_32_BYTES_RANDOM

# ---- 网关 / 短信上行回调签名（P3-⑥）----
# 生产必须开启；密钥至少 32 字节随机串
CALLBACK_SIGN_ENABLED=true
CALLBACK_SIGN_SECRET=CHANGE_ME_32_BYTES_RANDOM
# 短信上行也可改用 token 通道（二选一，签名优先）
SMS_UPSTREAM_TOKEN=
SMS_UPSTREAM_ENABLED=true

# ---- PBX 媒体与网关口令 ----
CALL_PBX_MEDIA_AUTH_KEY=CHANGE_ME_32_BYTES_RANDOM
ESL_PASSWORD=CHANGE_ME_ESL_PASSWORD
AMI_USER=admin
AMI_PASSWORD=CHANGE_ME_AMI_PASSWORD

# ---- 外呼合规 ----
CALL_OUTBOUND_SIMULATEANSWER=false
CALL_OUTBOUND_ALLOWED_HOURS=09:00-21:00

# ---- 前端（构建期注入，禁止写入 .env.production）----
VUE_APP_SIP_PASSWORD=CHANGE_ME_SIP_PASSWORD

# ---- TLS ----
TLS_FORCE_REDIRECT=true
TLS_SERVER_NAME=your.domain.example
AIUSER_TLS_FORCE_REDIRECT=true
AIUSER_TLS_SERVER_NAME=your.domain.example

# ---- Druid / Swagger ----
DRUID_CONSOLE_ENABLED=false
SWAGGER_ENABLED=false

# ---- N1② 流式语音（/ws/voice 实时 ASR/TTS；不填则保持 mock 链路，行为零差异）----
# 引擎：mock（本地联调）/ dashscope（云：paraformer-realtime-v2 ASR + cosyvoice-v1 TTS）/ cosyvoice2（内网 TTS）
VOICE_ENGINE=mock
# DashScope 云侧凭证：ASR/TTS 共用；dashscope 引擎必须注入，否则注册表返回 null、会话显式回 ENGINE_UNAVAILABLE
VOICE_DASHSCOPE_API_KEY=
VOICE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 实时流式 ASR 模型（全双工 WebSocket，语雀 7.3 N1② 指定 paraformer-realtime-v2）
VOICE_DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
VOICE_DASHSCOPE_TTS_MODEL=cosyvoice-v1
VOICE_DASHSCOPE_VOICE=longxiaochun
# N1③ 内网自建 CosyVoice 2（OpenAI 兼容 /audio/speech）；base-url 留空时 cosyvoice2 引擎不可用
VOICE_COSYVOICE2_TTS_BASE_URL=
VOICE_COSYVOICE2_TTS_MODEL=CosyVoice2-0.5B
VOICE_COSYVOICE2_VOICE=longxiaochun
VOICE_COSYVOICE2_API_KEY=
# 质检转写 ASR（Whisper 兼容 /audio/transcriptions，非实时链路）
VOICE_ASR_BASE_URL=http://localhost:8000/v1
VOICE_ASR_API_KEY=
VOICE_ASR_MODEL=whisper-1
VOICE_ASR_LANGUAGE=zh
# 服务端 VAD 与 Silero 影子验证（默认开 VAD、关影子）
VOICE_VAD_ENABLED=true
VOICE_VAD_SHADOW_ENABLED=false
VOICE_VAD_SHADOW_MODEL_PATH=models/silero_vad_int8.onnx
VOICE_VAD_SHADOW_THRESHOLD=0.5
VOICE_VAD_SHADOW_REPORT_CRON=0 5 0 * * ?
VOICE_VAD_SHADOW_SESSION_SAMPLE_RATE=0

# ---- N2（语雀 7.4）仿真评测灰度准入门禁（0~1 比率，仅写仿真报告 gate 块，不阻断任务）----
# S3 机器人意图准确率门槛（机器人仿真用例通过率）
AI_SIMULATION_GATE_INTENT_ACCURACY=0.85
# S2 Copilot 法条推荐命中率门槛
AI_SIMULATION_GATE_LAW_HIT_RATE=0.70
# S2 相似工单 Top3 有用率（预留：仿真尚无工单检查点，当前不参与判定）
AI_SIMULATION_GATE_TICKET_USEFUL_RATE=0.60

# ---- Actuator 独立管理端口（C2/C5）----
# 容器内 actuator（health/readiness/prometheus）监听端口，与业务 8080 隔离，
# 仅容器内网 expose、不发布宿主；容器健康检查即打此端口的 /actuator/health/readiness。
# 一般保持默认即可；本地开发不设此变量时回退与业务端口共用 8080。
MANAGEMENT_SERVER_PORT=8081
