  "description": "N6（语雀《下一步开发计划V1.2》7.8）单页语音 SLO 看板：TTFW/ASR-final/丢帧率/打断成功率 4 核心 SLO + 全链路语音延迟与降级明细。指标来自 HotlineMetrics 经 /actuator/prometheus 导出。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ai12348", "voice", "slo", "n6"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "12348 热线 · 语音 SLO 单页看板（N6 7.8）",
  "uid": "ai12348-voice-slo",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "核心 SLO（4 项验收指标）",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "① TTFW P95（停止说话→首帧音频，预算 1500ms）单位:ms",
      "description": "histogram_quantile 计算，按 source(robot/ask) 分线；超 1500ms 触发 VoiceTtfwP95OverBudget",
      "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(hotline_voice_ttfw_ms_seconds_bucket[5m])))",
          "legendFormat": "P95 {{source}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "② ASR final P95（语音段结束→final，预算 800ms）单位:ms",
      "description": "超 800ms 触发 VoiceAsrFinalP95OverBudget",
      "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hotline_voice_asr_final_ms_seconds_bucket[5m])))",
          "legendFormat": "ASR final P95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "④ PBX 下行丢帧率（预算 < 0.5%）",
      "description": "dropped/(accepted+dropped)；超 0.5% 触发 VoiceDownlinkDropRatioHigh",
      "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.005 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
          "expr": "sum(rate(hotline_voice_downlink_frame_total{result=\"dropped\"}[5m])) / (sum(rate(hotline_voice_downlink_frame_total{result=\"accepted\"}[5m])) + sum(rate(hotline_voice_downlink_frame_total{result=\"dropped\"}[5m])))",
          "legendFormat": "丢帧率"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "⑤ 打断成功率（within300，预算 ≥ 95%）",
      "description": "300ms 内停播占比；低于 95% 触发 VoiceBargeinSuccessRatioLow",
      "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ai12348-prom" },
          "expr": "sum(rate(hotline_voice_bargein_stop_ms_seconds_count{result=\"within300\"}[5m])) / sum(rate(hotline_voice_bargein_stop_ms_seconds_count[5m]))",
          "legendFormat": "打断成功率"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "全链路语音延迟分位（明细）",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
